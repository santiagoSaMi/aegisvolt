# Variables de DESARROLLO del frontend (las lee vite.config.ts; no se incluyen en el bundle).
# Copiar a .env (ignorado por Git). Sin secretos.
#
# La configuración por ambiente NO va en el bundle: se sirve en tiempo de ejecución
# como config.json (ADR-0017). En `pnpm dev` la genera vite.config.ts con estas variables.

# Destino del proxy de desarrollo para /graphql (mismo origen que el SPA).
DEV_GRAPHQL_PROXY_TARGET=http://localhost:4000
# Destino del proxy /auth/cognito (Cognito de Floci).
DEV_COGNITO_PROXY_TARGET=http://localhost:4566
# App client público del User Pool local (no es un secreto). Ver docs/runbooks.
DEV_COGNITO_CLIENT_ID=
# Ambiente que muestra config.json en desarrollo (debe coincidir con APP_ENV del graphql-api).
DEV_APP_ENV=local
DEV_POLLING_INTERVAL_MS=5000
DEV_CITIES=bogota
