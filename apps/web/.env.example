# Variables de DESARROLLO del frontend (las lee vite.config.ts; no se incluyen en el bundle).
# Copiar a .env (ignorado por Git). Sin secretos.
#
# La configuración por ambiente (environment, graphqlUrl) NO va aquí: se sirve en
# tiempo de ejecución desde public/config.json, distinta en cada ambiente (ADR-0017).

# Destino del proxy de desarrollo para /graphql (mismo origen que el SPA).
DEV_GRAPHQL_PROXY_TARGET=http://localhost:4000
