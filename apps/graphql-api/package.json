{
  "name": "@aegisvolt/graphql-api",
  "version": "0.0.0",
  "private": true,
  "description": "Capa de agregación GraphQL (BFF) de AegisVolt.",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aegisvolt/config": "workspace:*",
    "@aegisvolt/contracts": "workspace:*",
    "@aegisvolt/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
