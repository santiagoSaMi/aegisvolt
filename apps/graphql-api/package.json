{
  "name": "@aegisvolt/graphql-api",
  "version": "0.0.0",
  "private": true,
  "description": "Capa de agregación GraphQL (BFF) de AegisVolt.",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aegisvolt/config": "workspace:*",
    "@aegisvolt/contracts": "workspace:*",
    "@aegisvolt/feature-flags": "workspace:*",
    "@aegisvolt/logger": "workspace:*",
    "@aws-sdk/client-dynamodb": "3.1163.0",
    "@aws-sdk/lib-dynamodb": "3.1163.0",
    "@smithy/node-http-handler": "4.14.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
