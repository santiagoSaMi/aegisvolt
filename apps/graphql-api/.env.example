# Plantilla de variables de graphql-api.
# Copiar a .env (ignorado por Git). Valores FICTICIOS, válidos solo en local.
APP_ENV=local
SERVICE_VERSION=local
PORT=4000
LOG_LEVEL=debug
AWS_REGION=us-east-1

# Solo en local (Floci). En AWS real no se define y el SDK usa los endpoints por defecto.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciales FICTICIAS del emulador. Nunca credenciales reales.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Fases siguientes (aún no se leen):
# FEATURE_FLAGS_TABLE_NAME=aegisvolt-feature-flags-dev
# COGNITO_ISSUER=http://localhost:4566/<userPoolId>
# COGNITO_CLIENT_ID=<clientId>
# SAGA_ORCHESTRATOR_URL=http://localhost:4100
