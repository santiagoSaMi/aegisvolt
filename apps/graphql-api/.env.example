# Plantilla de variables de graphql-api.
# Copiar a .env (ignorado por Git). Valores FICTICIOS, válidos solo en local.
APP_ENV=local
SERVICE_VERSION=local
PORT=4000
LOG_LEVEL=debug
AWS_REGION=us-east-1

# Solo en local (Floci). En AWS real no se define y el SDK usa los endpoints por defecto.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciales FICTICIAS del emulador. Nunca credenciales reales.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Flags del ambiente: ÚNICA tabla que usa el graphql-api (ADR-0025). Por defecto aegisvolt-feature-flags-<APP_ENV>.
FEATURE_FLAGS_TABLE_NAME=aegisvolt-feature-flags-local
FEATURE_FLAGS_CACHE_TTL_MS=5000

# Servicios internos (en Kubernetes, nombres de Service). Nunca sus tablas.
STATION_RESERVATION_URL=http://localhost:4101
BILLING_WALLET_URL=http://localhost:4102
ENERGY_DISPATCH_URL=http://localhost:4103
SAGA_ORCHESTRATOR_URL=http://localhost:4100
# Timeout por intento, reintentos selectivos (solo idempotentes y transitorios) y espera de la SAGA.
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_MAX_RETRIES=1
SAGA_START_TIMEOUT_MS=25000

# Cognito del ambiente (ADR-0008). En Floci, el `iss` usa el hostname floci y el JWKS se lee por localhost.
# Crear pool/client/grupos/usuarios: ver docs/graphql/README.md.
COGNITO_ISSUER=http://floci:4566/<userPoolId>
COGNITO_JWKS_URL=http://localhost:4566/<userPoolId>/.well-known/jwks.json
COGNITO_CLIENT_ID=<appClientId>

# Introspección: por defecto habilitada salvo en prod. Profundidad máxima de un documento.
GRAPHQL_MAX_DEPTH=8

SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_GRACE_MS=35000
