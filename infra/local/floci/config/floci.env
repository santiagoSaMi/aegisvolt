# Configuración del SERVIDOR Floci (no contiene secretos).
# Nombres verificados en https://floci.io/floci/configuration/environment-variables/

# Debe coincidir con el nombre del servicio en docker-compose.yml.
FLOCI_HOSTNAME=floci

# La imagen publicada usa `memory` por defecto: hay que fijarlo explícitamente.
# `persistent` = escritura síncrona a disco en cada cambio (no se pierde un lote
# pendiente al reiniciar, a diferencia de `hybrid`).
FLOCI_STORAGE_MODE=persistent
FLOCI_STORAGE_PERSISTENT_PATH=/app/data

# Red Docker para los contenedores que Floci crea (Lambda, ECS, EKS...).
FLOCI_SERVICES_DOCKER_NETWORK=aegisvolt-floci

# Docker Engine 29 usa el image store de containerd; la doc de ECR recomienda
# URIs estilo path: localhost:<port>/<account>/<region>/<repo>
FLOCI_SERVICES_ECR_URI_STYLE=path
