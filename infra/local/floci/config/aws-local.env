# Configuración del CLIENTE (AWS CLI / SDK) apuntando a Floci.
# Credenciales FICTICIAS, válidas solo contra el emulador local.
# Uso: set -a; source infra/local/floci/config/aws-local.env; set +a
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Evita leer ~/.aws por accidente y que se use un perfil real.
AWS_CONFIG_FILE=/dev/null
AWS_SHARED_CREDENTIALS_FILE=/dev/null
AWS_PAGER=
