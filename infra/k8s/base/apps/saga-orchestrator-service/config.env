# Configuración NO sensible de saga-orchestrator-service (ConfigMap saga-orchestrator-service-config).
# APP_ENV y los nombres de tabla los fija cada overlay; sin secretos (credenciales: IRSA en AWS,
# Secret ficticio del componente floci en local).
PORT=8080
LOG_LEVEL=info
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=set-by-overlay
HTTP_REQUEST_TIMEOUT_MS=30000
STATION_RESERVATION_URL=http://station-reservation-service
BILLING_WALLET_URL=http://billing-wallet-service
ENERGY_DISPATCH_URL=http://energy-dispatch-service
RECOVERY_ENABLED=true
SHUTDOWN_GRACE_MS=35000
SHUTDOWN_DRAIN_DELAY_MS=0
