# Plantilla de variables de saga-orchestrator-service.
# Copiar a .env (ignorado por Git). Valores FICTICIOS, válidos solo en local.
APP_ENV=local
SERVICE_VERSION=local
PORT=4100
LOG_LEVEL=debug
AWS_REGION=us-east-1

# Solo en local (Floci). En AWS real no se define y el SDK usa los endpoints por defecto.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciales FICTICIAS del emulador. Nunca credenciales reales.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Tabla de SAGAs (en los ambientes la crea Terraform).
# Local: pnpm --filter @aegisvolt/saga-orchestrator-service db:create-local-table
DYNAMODB_TABLE_NAME=aegisvolt-sagas-local

# Servicios participantes (en Kubernetes, nombres de Service).
STATION_RESERVATION_URL=http://localhost:4101
BILLING_WALLET_URL=http://localhost:4102
ENERGY_DISPATCH_URL=http://localhost:4103

# Timeouts y reintentos (solo errores transitorios; los rechazos de negocio no se reintentan).
SAGA_STEP_TIMEOUT_MS=3000
SAGA_FORWARD_MAX_ATTEMPTS=3
SAGA_FORWARD_BASE_DELAY_MS=200
SAGA_FORWARD_MAX_DELAY_MS=2000
SAGA_COMPENSATION_ATTEMPTS=3
SAGA_COMPENSATION_MAX_ROUNDS=10
SAGA_COMPENSATION_BASE_DELAY_MS=5000
SAGA_COMPENSATION_MAX_DELAY_MS=900000
# Lease > 2 × SAGA_STEP_TIMEOUT_MS + SAGA_FORWARD_MAX_DELAY_MS.
SAGA_LEASE_MS=30000
SAGA_SYNC_WAIT_MS=20000

# Recuperación de SAGAs pendientes (worker en proceso; también: pnpm saga:recover).
RECOVERY_ENABLED=true
RECOVERY_INTERVAL_MS=10000
RECOVERY_STALE_AFTER_MS=15000
SAGA_FORWARD_DEADLINE_MS=60000
RECOVERY_BATCH_SIZE=25

HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_GRACE_MS=40000
