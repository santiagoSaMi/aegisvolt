# Plantilla de variables de energy-dispatch-service.
# Copiar a .env (ignorado por Git). Valores FICTICIOS, válidos solo en local.
APP_ENV=local
SERVICE_VERSION=local
PORT=4103
LOG_LEVEL=debug
AWS_REGION=us-east-1

# Solo en local (Floci). En AWS real no se define y el SDK usa los endpoints por defecto.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciales FICTICIAS del emulador. Nunca credenciales reales.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Tabla del servicio (en los ambientes la crea Terraform).
# Local: pnpm --filter @aegisvolt/energy-dispatch-service db:create-local-table
DYNAMODB_TABLE_NAME=aegisvolt-dispatch-local

# Flags del ambiente (solo lectura, ADR-0007). SIMULATE_CHARGER_HARDWARE_FAULT se lee de aquí.
# Local: pnpm --filter @aegisvolt/feature-flags flags:create-local-table local
FEATURE_FLAGS_TABLE_NAME=aegisvolt-feature-flags-local
FEATURE_FLAGS_CACHE_TTL_MS=5000

# Presupuestos de tiempo (ADR-0004). DYNAMODB_REQUEST_TIMEOUT_MS × DYNAMODB_MAX_ATTEMPTS < HTTP_REQUEST_TIMEOUT_MS.
HTTP_REQUEST_TIMEOUT_MS=5000
DYNAMODB_CONNECTION_TIMEOUT_MS=1000
DYNAMODB_REQUEST_TIMEOUT_MS=2000
DYNAMODB_MAX_ATTEMPTS=2

# Retención de la telemetría (atributo ttl).
TELEMETRY_RETENTION_DAYS=30

# Apagado ordenado: readiness en 503 durante el drenado; plazo > HTTP_REQUEST_TIMEOUT_MS.
SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_GRACE_MS=10000
