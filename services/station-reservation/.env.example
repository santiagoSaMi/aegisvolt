# Plantilla de variables de station-reservation-service.
# Copiar a .env (ignorado por Git). Valores FICTICIOS, válidos solo en local.
APP_ENV=local
SERVICE_VERSION=local
PORT=4101
LOG_LEVEL=debug
AWS_REGION=us-east-1

# Endpoint de AWS: obligatorio con APP_ENV=local (Floci). En AWS real NO se define
# y el SDK usa el endpoint regional. Nunca está en el código.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciales FICTICIAS del emulador. Nunca credenciales reales.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Tabla del servicio (en los ambientes la crea Terraform).
# Local: pnpm --filter @aegisvolt/station-reservation-service db:create-local-table
DYNAMODB_TABLE_NAME=aegisvolt-reservations-local

# Presupuestos de tiempo (ADR-0004). DYNAMODB_REQUEST_TIMEOUT_MS × DYNAMODB_MAX_ATTEMPTS < HTTP_REQUEST_TIMEOUT_MS.
HTTP_REQUEST_TIMEOUT_MS=5000
DYNAMODB_CONNECTION_TIMEOUT_MS=1000
DYNAMODB_REQUEST_TIMEOUT_MS=2000
DYNAMODB_MAX_ATTEMPTS=2

# Política de reserva temporal (hold): vence sola, sin depender del TTL de DynamoDB.
RESERVATION_STANDARD_HOLD_MS=120000
RESERVATION_BOOSTED_HOLD_MS=300000

# Flags del ambiente (solo lectura, ADR-0025). Por defecto aegisvolt-feature-flags-<APP_ENV>.
# Local: pnpm --filter @aegisvolt/feature-flags flags:create-local-table local
# Cambiar una flag sin reiniciar: scripts/flags/set.sh local <FLAG> <true|false>
FEATURE_FLAGS_TABLE_NAME=aegisvolt-feature-flags-local
FEATURE_FLAGS_CACHE_TTL_MS=5000
