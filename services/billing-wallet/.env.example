# Plantilla de variables de billing-wallet-service.
# Copiar a .env (ignorado por Git). Valores FICTICIOS, válidos solo en local.
APP_ENV=local
SERVICE_VERSION=local
PORT=4102
LOG_LEVEL=debug
AWS_REGION=us-east-1

# Solo en local (Floci). En AWS real no se define y el SDK usa los endpoints por defecto.
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciales FICTICIAS del emulador. Nunca credenciales reales.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Tabla del servicio (en los ambientes la crea Terraform).
# Local: pnpm --filter @aegisvolt/billing-wallet-service db:create-local-table
DYNAMODB_TABLE_NAME=aegisvolt-billing-local

# Presupuestos de tiempo (ADR-0004). DYNAMODB_REQUEST_TIMEOUT_MS × DYNAMODB_MAX_ATTEMPTS < HTTP_REQUEST_TIMEOUT_MS.
HTTP_REQUEST_TIMEOUT_MS=5000
DYNAMODB_CONNECTION_TIMEOUT_MS=1000
DYNAMODB_REQUEST_TIMEOUT_MS=2000
DYNAMODB_MAX_ATTEMPTS=2

# Moneda de las billeteras (ISO 4217). Todos los importes en unidades menores ENTERAS (centavos).
WALLET_CURRENCY=COP
# Tarifas por kWh en unidades menores, por clase de potencia (<50 kW, 50–149 kW, ≥150 kW).
PRICING_TARIFF_STANDARD_MINOR_PER_KWH=80000
PRICING_TARIFF_FAST_MINOR_PER_KWH=100000
PRICING_TARIFF_ULTRA_FAST_MINOR_PER_KWH=140000
# Surge en puntos básicos (12500 = 1,25×) y ventanas pico en hora local.
PRICING_SURGE_MULTIPLIER_BP=12500
PRICING_PEAK_WINDOWS=17:00-21:00
PRICING_UTC_OFFSET_MINUTES=-300

# Provisional hasta el lector de flags en DynamoDB (ADR-0007).
FEATURE_ENABLE_DYNAMIC_SURGE_PRICING=false
